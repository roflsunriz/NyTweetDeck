{
  "name": "nytweetdeck-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot scripts/dev-server.ts",
    "build": "bun scripts/build.ts",
    "lint": "biome lint .",
