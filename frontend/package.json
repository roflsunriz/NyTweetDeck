{
  "name": "nytweetdeck-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot scripts/dev-server.ts",
    "build": "bun scripts/build.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "capture:readme": "bun scripts/capture-readme.ts",
    "verify:ui": "bun scripts/cdp-verify.ts",
    "sandbox:capture-x-reference": "bun scripts/sandbox/capture-x-reference.ts",
    "sandbox:capture-x-surfaces": "bun scripts/sandbox/capture-x-surfaces.ts",
    "sandbox:analyze-x-reference": "bun scripts/sandbox/analyze-x-reference.ts",
    "sandbox:inventory-x-reference": "bun scripts/sandbox/inventory-x-reference.ts",
    "sandbox:inventory-x-surfaces": "bun scripts/sandbox/inventory-x-surfaces.ts",
    "sandbox:observe-x-dynamic": "bun scripts/sandbox/observe-x-dynamic-scenarios.ts",
    "sandbox:observe-x-dynamic-matrix": "bun scripts/sandbox/observe-x-dynamic-matrix.ts",
    "sandbox:verify-x-offline": "bun scripts/sandbox/verify-x-offline-sandbox.ts",
    "sandbox:run-x-url-contract": "bun scripts/sandbox/run-offline-url-contract.ts"
